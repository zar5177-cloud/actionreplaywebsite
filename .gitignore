# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# python cache
__pycache__/
*.pyc

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Large local creative production workspaces
/action-replay-higgsfield/
/action-replay-openart-production/
/tmp/

# RND moderation scratch outputs
/action-replay-higgsfield/rnd/moderation-tests/assets/generated/
/action-replay-higgsfield/rnd/moderation-tests/outputs/
/action-replay-higgsfield/rnd/manual-higgsfield-handoff/outputs/

# Local apparel print extraction outputs
/outputs/
/.venv-apparel-extractor/
