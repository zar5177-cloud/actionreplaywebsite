SHOPIFY_STORE_DOMAIN=store.shopactionreplay.com
SHOPIFY_ADMIN_API_VERSION=2026-04
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_PRIVATE_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_NEWSLETTER_STOREFRONT_API_VERSION=2024-01
NEWSLETTER_DISCOUNT_CODE=REPLAY10
NEWSLETTER_EMAIL_FROM="Action Replay <notify@send.shopactionreplay.com>"
NEWSLETTER_SUPPORT_EMAIL=support@shopactionreplay.com
RESEND_API_KEY=
SITE_URL=https://shopactionreplay.com

# Server/operator only. Optional if SHOPIFY_CLIENT_ID and SHOPIFY_CLIENT_SECRET
# can mint an Admin token for scripts/shopify-sync-action-replay-metafields.mjs.
SHOPIFY_ADMIN_ACCESS_TOKEN=

SHOPIFY_GALAXY_TEE_VARIANT_BLACK_S=
SHOPIFY_GALAXY_TEE_VARIANT_BLACK_M=
SHOPIFY_GALAXY_TEE_VARIANT_BLACK_L=
SHOPIFY_GALAXY_TEE_VARIANT_BLACK_XL=
SHOPIFY_GALAXY_TEE_VARIANT_BLACK_XXL=

SHOPIFY_GALAXY_TEE_VARIANT_WHITE_S=
SHOPIFY_GALAXY_TEE_VARIANT_WHITE_M=
SHOPIFY_GALAXY_TEE_VARIANT_WHITE_L=
SHOPIFY_GALAXY_TEE_VARIANT_WHITE_XL=
SHOPIFY_GALAXY_TEE_VARIANT_WHITE_XXL=

SHOPIFY_PROMO_POSTER_VARIANT_24X36=

# Pair-only code applied server-side when the Shopify cart contains both
# the Galaxy Tee and the corrupted promo poster.
SHOPIFY_TEE_POSTER_DISCOUNT_CODE=

# First-party analytics / retention. All optional and env-gated.
# Clarity should still be installed through the official Shopify app when
# checkout/session replay coverage inside Shopify is needed.
CLARITY_PROJECT_ID=
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ENABLE_ANALYTICS_DEV=false

# Server-side Replay Club fallback. Prefer native Klaviyo Shopify integration
# and app embed for onsite tracking/forms when available.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=

# Optional first-party survey fallback. Default behavior is event/local only.
# Set to "file" in local/operator environments to append data/survey_responses.jsonl.
SURVEY_WRITE_MODE=

# Optional future Meta / Instagram official API setup.
# Keep real values in .env.local or a hosted secrets manager, never in git.
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
META_PRIMARY_PAGE_ID=
IG_SHOPACTIONREPLAY_USER_ID=
IG_REPLAY_RECOVERED_USER_ID=
IG_OVERRIDE_MONTHLY_USER_ID=
IG_SLOTB_TESTERS_USER_ID=
IG_MEMORYCARD_ERR_USER_ID=
IG_UNLOCK_LOG_TXT_USER_ID=
IG_BBS_MIRROR_2007_USER_ID=
